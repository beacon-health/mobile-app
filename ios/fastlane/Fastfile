default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Creates a temporary keychain on CI so cloud-managed signing certs can be
    # installed for this run only.
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    # Automatic ("cloud-managed") signing: Xcode fetches/creates the App Store
    # distribution certificate + provisioning profile via the App Store Connect
    # API key. `-allowProvisioningUpdates` authorizes that at archive time, so
    # no certs repo (Match) is required. The API key needs App Manager access.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios",
      xcargs: "-allowProvisioningUpdates",
      # Required: -allowProvisioningUpdates needs these credentials to mint
      # the distribution profile.
      api_key: api_key,
      export_options: {
        signingStyle: "automatic",
        teamID: "3VY6L9SG6K",
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Build release for App Store submission"
  lane :release do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios",
      xcargs: "-allowProvisioningUpdates",
      api_key: api_key,
      export_options: {
        signingStyle: "automatic",
        teamID: "3VY6L9SG6K",
      },
    )

    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
    )
  end
end
