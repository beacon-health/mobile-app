{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./config/dart_defines.json)",
      "Read(./ios/Flutter/Secrets.xcconfig)",
      "Read(./sentry.properties)",
      "Read(./android/local.properties)",
      "Read(./android/key.properties)",
      "Read(./android/app/google-services.json)",
      "Read(./ios/Runner/GoogleService-Info.plist)",
      "Read(**/*.p8)",
      "Read(**/*.jks)",
      "Read(./.env)",
      "Read(**/.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh repo delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(flutter build ipa:*)",
      "Bash(flutter build appbundle:*)",
      "Bash(bundle exec fastlane:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset:*)",
      "Bash(supabase link:*)"
    ],
    "allow": [
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get)",
      "Bash(flutter pub outdated:*)",
      "Bash(flutter pub upgrade:*)",
      "Bash(flutter pub deps:*)",
      "Bash(flutter gen-l10n:*)",
      "Bash(flutter doctor:*)",
      "Bash(flutter devices:*)",
      "Bash(flutter emulators:*)",
      "Bash(flutter clean)",
      "Bash(flutter config:*)",
      "Bash(flutter run:*)",
      "Bash(flutter build apk:*)",
      "Bash(flutter build ios:*)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(dart run:*)",
      "Bash(dart fix:*)",
      "Bash(make:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git remote -v)",
      "Bash(git check-ignore:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push)",
      "Bash(gh pr create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api:*)",
      "Bash(gh auth status:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed -n:*)",
      "Bash(which:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(sw_vers:*)",
      "Bash(uname:*)",
      "Bash(open -a Simulator)",
      "Bash(xcrun simctl list:*)",
      "Bash(xcrun simctl boot:*)",
      "Bash(adb devices:*)",
      "Bash(pod install:*)",
      "Bash(pod repo update:*)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Bash(brew search:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-secret-reads.sh"
          }
        ]
      }
    ]
  }
}
