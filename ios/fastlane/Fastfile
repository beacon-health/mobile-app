require "shellwords"
require "tmpdir"

default_platform(:ios)

# `build_app` has no api_key option, so the archive step can't be handed a
# fastlane key object. Materialize the base64 secret as a .p8 and pass
# xcodebuild its own auth flags — without these, `-allowProvisioningUpdates`
# has no credentials and fails with "No profiles for 'org.beaconhealth.app'".
def asc_signing_xcargs
  key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ID")
  issuer_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID")
  key_path = File.join(Dir.mktmpdir("asc"), "AuthKey_#{key_id}.p8")
  File.write(key_path, ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT").unpack1("m"))
  File.chmod(0o600, key_path)

  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath", key_path.shellescape,
    "-authenticationKeyID", key_id.shellescape,
    "-authenticationKeyIssuerID", issuer_id.shellescape,
  ].join(" ")
end

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Creates a temporary keychain on CI so cloud-managed signing certs can be
    # installed for this run only.
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    # Automatic ("cloud-managed") signing: Xcode fetches/creates the App Store
    # distribution certificate + provisioning profile via the App Store Connect
    # API key, so no certs repo (Match) is required. Needs App Manager access.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios",
      xcargs: asc_signing_xcargs,
      export_options: {
        signingStyle: "automatic",
        teamID: "3VY6L9SG6K",
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Build release for App Store submission"
  lane :release do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios",
      xcargs: asc_signing_xcargs,
      export_options: {
        signingStyle: "automatic",
        teamID: "3VY6L9SG6K",
      },
    )

    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
    )
  end
end
